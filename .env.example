# Copy to .env for local development. Never commit .env.
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=

# Leave DATABASE_URL unset to use SQLite locally. For PostgreSQL:
# DATABASE_URL=postgres://jobtrail:password@localhost:5432/jobtrail
DATABASE_SSL_REQUIRE=false

# Production-only knobs (read when DJANGO_DEBUG=false)
DJANGO_SECURE_SSL_REDIRECT=true
DJANGO_HSTS_SECONDS=3600
